{
	"name": "anycode-kotlin",
	"displayName": "anycode-kotlin",
	"version": "0.0.1",
	"private": false,
	"description": "Kotlin for Anycode",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandAnycode#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandAnycode/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandAnycode.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"deploy": "npx vsce publish",
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"contributes": {
		"anycodeLanguages": {
			"extensions": [
				"kt"
			],
			"grammarPath": "./tree-sitter-kotlin.wasm",
			"languageId": "kotlin",
			"queryPaths": {
				"comments": "./queries/comments.scm",
				"folding": "./queries/folding.scm",
				"identifiers": "./queries/identifiers.scm",
				"references": "./queries/references.scm"
			}
		},
		"languages": [
			{
				"aliases": [
					"kotlin"
				],
				"extensions": [
					"kt"
				],
				"id": "kotlin"
			}
		]
	},
	"dependencies": {},
	"devDependencies": {
		"@playform/build": "0.2.1",
		"@swimm/tree-sitter-kotlin": "^0.3.2",
		"tree-sitter-cli": "^0.25.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"preview": true
}
