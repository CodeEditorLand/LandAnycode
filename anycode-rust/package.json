{
	"name": "anycode-rust",
	"displayName": "anycode-rust",
	"version": "0.0.1",
	"private": false,
	"description": "Rust for Anycode",
	"keywords": [
		"codeeditorland",
		"land",
		"playform"
	],
	"homepage": "HTTPS://GitHub.Com/CodeEditorLand/LandAnycode#readme",
	"bugs": {
		"url": "HTTPS://GitHub.Com/CodeEditorLand/LandAnycode/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+HTTPS://github.com/CodeEditorLand/LandAnycode.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "HTTPS://Editor.Land"
	},
	"type": "module",
	"scripts": {
		"prepublishOnly": "Build 'Source/**/*.ts'"
	},
	"contributes": {
		"anycodeLanguages": {
			"extensions": [
				"rs"
			],
			"grammarPath": "./tree-sitter-rust.wasm",
			"languageId": "rust",
			"queryPaths": {
				"comments": "./queries/comments.scm",
				"folding": "./queries/folding.scm",
				"identifiers": "./queries/identifiers.scm",
				"locals": "./queries/locals.scm",
				"outline": "./queries/outline.scm",
				"references": "./queries/references.scm"
			},
			"suppressedBy": [
				"rust-lang.rust-analyzer"
			]
		}
	},
	"dependencies": {},
	"devDependencies": {
		"@playform/build": "0.2.3",
		"tree-sitter-cli": "0.25.3",
		"tree-sitter-rust": "0.24.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"preview": true
}
